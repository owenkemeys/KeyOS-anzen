export component AppWindow inherits Window {
    in-out property <int> stage: 0;
    in-out property <bool> success: false;
    in-out property <string> status-title: "Ready to import";
    in-out property <string> status-detail: "Reads anzen-policy-v4.json from the development USB folder. No signing key is used during import.";
    in-out property <string> environment: "PASSPORT PRIME · KEYOS";
    in-out property <string> vault-amount: "—";
    in-out property <string> monthly-access: "—";
    in-out property <string> emergency-access: "—";
    in-out property <string> network-label: "—";
    in-out property <string> fee-label: "—";
    in-out property <string> transaction-label: "—";
    in-out property <string> operation-title: "Import HWW request";
    in-out property <string> primary-label: "VAULT";
    in-out property <string> secondary-label: "MONTHLY ACCESS";
    in-out property <string> tertiary-label: "EMERGENCY";
    callback primary-requested();
    callback sweep-requested();
    callback rotation-requested();
    callback hww-recovery-requested();
    callback phone-backup-requested();

    title: "Anzen Policy Approval";
    preferred-width: 480px;
    preferred-height: 800px;
    background: #111416;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 36px;
        padding-bottom: 24px;
        spacing: 14px;

        Text {
            text: "ANZEN  ×  PRIME";
            color: #f5a623;
            font-family: "Montserrat";
            font-size: 18px;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Text {
            text: root.environment;
            color: #929ba1;
            font-family: "Montserrat";
            font-size: 11px;
            font-weight: 650;
            horizontal-alignment: center;
        }

        Text {
            text: root.stage == 2 ? "Request approved" : root.operation-title;
            color: #ffffff;
            font-family: "Montserrat";
            font-size: 28px;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Rectangle {
            visible: root.stage == 1;
            width: 100%;
            height: 304px;
            border-radius: 20px;
            background: #1d2226;
            border-width: 1px;
            border-color: #343b40;

            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                Text { text: root.primary-label; color: #929ba1; font-family: "Montserrat"; font-size: 12px; font-weight: 700; }
                Text { text: root.vault-amount; color: #ffffff; font-family: "Montserrat"; font-size: 23px; font-weight: 750; }
                Rectangle { height: 1px; background: #343b40; }
                Text { text: root.secondary-label; color: #929ba1; font-family: "Montserrat"; font-size: 12px; font-weight: 700; }
                Text { text: root.monthly-access; color: #ffffff; font-family: "Montserrat"; font-size: 16px; font-weight: 650; wrap: word-wrap; }
                Rectangle { height: 1px; background: #343b40; }
                Text { text: root.tertiary-label; color: #929ba1; font-family: "Montserrat"; font-size: 12px; font-weight: 700; }
                Text { text: root.emergency-access; color: #ffffff; font-family: "Montserrat"; font-size: 18px; font-weight: 650; }
                Rectangle { height: 1px; background: #343b40; }
                Text {
                    text: root.network-label + "  ·  " + root.fee-label + "  ·  " + root.transaction-label;
                    color: #aeb6bb;
                    font-family: "Montserrat";
                    font-size: 13px;
                    font-weight: 550;
                    horizontal-alignment: center;
                }
            }
        }

        Rectangle {
            width: 100%;
            height: root.stage == 0 ? 190px : root.success ? 244px : 132px;
            border-radius: 20px;
            background: root.success ? #17382c : #171b1e;
            border-width: 1px;
            border-color: root.success ? #3ac47d : #343b40;

            VerticalLayout {
                padding: 18px;
                spacing: 9px;
                Text {
                    text: root.success ? "✓  " + root.status-title : root.status-title;
                    color: root.success ? #69dfa0 : #ffffff;
                    font-family: "Montserrat";
                    font-size: root.success ? 20px : 19px;
                    font-weight: 750;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.status-detail;
                    color: root.success ? #d6f7e4 : #aeb6bb;
                    font-family: "Montserrat";
                    font-size: 14px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        Rectangle {
            visible: root.stage == 0;
            width: 100%;
            height: 56px;
            border-radius: 26px;
            background: sweep-touch.pressed ? #2c3439 : #1d2226;
            border-width: 1px;
            border-color: #59636a;

            Text {
                width: parent.width;
                height: parent.height;
                text: "Import cooperative sweep";
                color: #ffffff;
                font-family: "Montserrat";
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            sweep-touch := TouchArea { clicked => { root.sweep-requested(); } }
        }

        Rectangle {
            visible: root.stage == 0;
            width: 100%;
            height: 56px;
            border-radius: 26px;
            background: rotation-touch.pressed ? #2c3439 : #1d2226;
            border-width: 1px;
            border-color: #59636a;

            Text {
                width: parent.width;
                height: parent.height;
                text: "Import phone-key rotation";
                color: #ffffff;
                font-family: "Montserrat";
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            rotation-touch := TouchArea { clicked => { root.rotation-requested(); } }
        }

        Rectangle {
            visible: root.stage == 0;
            width: 100%;
            height: 56px;
            border-radius: 26px;
            background: recovery-touch.pressed ? #2c3439 : #1d2226;
            border-width: 1px;
            border-color: #59636a;

            Text {
                width: parent.width;
                height: parent.height;
                text: "Import delayed HWW recovery";
                color: #ffffff;
                font-family: "Montserrat";
                font-size: 16px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            recovery-touch := TouchArea { clicked => { root.hww-recovery-requested(); } }
        }

        Rectangle {
            visible: root.stage == 0;
            width: 100%;
            height: 56px;
            border-radius: 26px;
            background: backup-touch.pressed ? #2c3439 : #1d2226;
            border-width: 1px;
            border-color: #59636a;
            Text {
                width: parent.width; height: parent.height;
                text: "Decrypt phone backup";
                color: #ffffff; font-family: "Montserrat"; font-size: 16px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
            backup-touch := TouchArea { clicked => { root.phone-backup-requested(); } }
        }

        Rectangle {
            width: 100%;
            height: 64px;
            border-radius: 28px;
            background: touch.pressed ? #d98a12 : #f5a623;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.stage == 0 ? "Import annual policy" : root.stage == 1 ? "Approve and export" : "Import another request";
                color: #111416;
                font-family: "Montserrat";
                font-size: 18px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            touch := TouchArea { clicked => { root.primary-requested(); } }
        }

        Text {
            text: "Development file bridge · Anzen 01794bb";
            color: #727b81;
            font-family: "Montserrat";
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: center;
        }
    }
}
